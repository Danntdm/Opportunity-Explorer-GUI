# Copy this file to .env and fill in your key. Never commit .env.

# Gemini
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash-lite

# To use OpenAI instead, replace the three lines above with:
# LLM_API_KEY=your-openai-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-6-luna

# Optional: use a different model for each step. Either one falls back to LLM_MODEL.
# LLM_QUESTIONS_MODEL=gpt-6-luna
# LLM_REPORT_MODEL=gpt-6.1-sol
